{%- liquid
  assign popup_id = 'PromoPopup-' | append: section.id
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}

{%- style -%}
  .promo-popup {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(0, 0, 0, 0.35);
  }

  .promo-popup.is-open {
    display: flex;
  }

  .promo-popup__dialog {
    position: relative;
    display: grid;
    grid-template-columns: {% if has_image %}1fr 1fr{% else %}1fr{% endif %};
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    max-height: 475px;

    overflow: auto;
    border-radius: 24px;
    background: {{ section.settings.background_color }};
  }

  .promo-popup__media {
    margin: 0;
    min-height: 100%;
  }

  .promo-popup__media img {
        display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px 0 0 24px;
  }

  .promo-popup__content {

    padding: 68px 65px;

    text-align: left;
  }

  .promo-popup__close {
    position: absolute;
    top: 1.6rem;
    right: 1.6rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: {{ section.settings.heading_color }};
    cursor: pointer;
  }

  .promo-popup__heading {
    margin: 0;
    text-align: left;
    font-family: var(--font-body-family);

    font-weight: var(--font-weight-book);
    font-size: 68px;
    line-height: 92%;
    letter-spacing: 0;
    color: {{ section.settings.heading_color }};
  }

  .promo-popup__heading-emphasis {
    display: block;
    font-weight: var(--font-weight-medium);
  }

  .promo-popup__text {
    margin: 1.2rem 0 0;
    font-family: var(--font-body-family);
    font-weight: var(--font-weight-regular);
    font-size: 20px;
    line-height: 135%;
    letter-spacing: 0;
    color: {{ section.settings.text_color }};
  }

  .promo-popup__text > :first-child { margin-top: 0; }
  .promo-popup__text > :last-child { margin-bottom: 0; }

  .promo-popup__form {
    margin: 2.8rem 0 0;
  }

  .promo-popup__field {
    display: block;
    width: 100%;
    height: 52px;
    padding: 0 2.4rem;
    border: 1px solid {{ section.settings.field_border_color }};
    border-radius: 52px;
    background: transparent;
    font-family: var(--font-body-family);

    font-weight: var(--font-weight-book);
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;
    color: {{ section.settings.text_color }};
    box-sizing: border-box;
  }

  .promo-popup__field::placeholder {
    font-weight: var(--font-weight-book);
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;
    color: {{ section.settings.placeholder_color }};

    opacity: 1;
  }

  .promo-popup__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
    height: 52px;
    margin-top: 1.2rem;
    padding: 0 2.4rem;
    border: 0;
    border-radius: 52px;
    background: {{ section.settings.button_color }};
    font-family: var(--font-body-family);

    font-weight: var(--font-weight-medium);
    font-size: 18px;
    line-height: 100%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: {{ section.settings.button_label_color }};
    cursor: pointer;
    box-sizing: border-box;
  }

  .promo-popup__message {
    margin: 1.6rem 0 0;
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 140%;
    color: {{ section.settings.text_color }};
  }

  .promo-popup__code {
    display: inline-block;
    margin: 1.2rem 0 0;
    padding: 1.2rem 2.4rem;
    border: 1px dashed {{ section.settings.field_border_color }};
    border-radius: 12px;
    font-family: var(--font-body-family);
    font-weight: var(--font-weight-medium);
    font-size: 24px;
    line-height: 100%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
  }

  .promo-popup__button--link {
    margin-top: 2rem;
    text-decoration: none;
  }

  .promo-popup__message--error {
    color: rgb(var(--color-error, 235 66 66));
  }

  @media screen and (max-width: 989px) {
    .promo-popup__heading { font-size: 48px; }
    .promo-popup__content { padding: 48px 40px; }
  }

  @media screen and (max-width: 749px) {
    .promo-popup { padding: 1.6rem; }

    .promo-popup__dialog {
      grid-template-columns: 1fr;
    }

    .promo-popup__media {
      max-height: 30vh;
    }

    .promo-popup__heading { font-size: 36px; }
    .promo-popup__text { font-size: 16px; }
    .promo-popup__content { padding: 32px 24px; }
  }
{%- endstyle -%}

<div
  class="promo-popup"
  id="{{ popup_id }}"
  data-promo-popup
  data-delay="{{ section.settings.delay }}"
  data-storage-key="promo-popup-{{ section.settings.reset_key | default: 1 }}"
  role="dialog"
  aria-modal="true"
  aria-label="{{ section.settings.heading | default: 'Newsletter' | strip_html | escape }}"
  hidden
>
  <div class="promo-popup__dialog">
    <button
      type="button"
      class="promo-popup__close"
      data-promo-popup-close
      aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
        <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    {%- if has_image -%}
      <figure class="promo-popup__media">
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 450px, 100vw',
            widths: '375, 450, 750, 900',
            alt: section.settings.image.alt
        }}
      </figure>
    {%- endif -%}

    <div class="promo-popup__content">
      <h2 class="promo-popup__heading">
        {{ section.settings.heading }}
        {%- if section.settings.heading_emphasis != blank -%}
          <span class="promo-popup__heading-emphasis">{{ section.settings.heading_emphasis }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.text != blank -%}
        <div class="promo-popup__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'promo-popup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <p class="promo-popup__message" data-promo-popup-result>{{ section.settings.success_text }}</p>
          {%- if section.settings.discount_code != blank -%}
            <p class="promo-popup__code">{{ section.settings.discount_code }}</p>
          {%- endif -%}
          {%- if section.settings.success_button_label != blank and section.settings.success_button_link != blank -%}
            <a href="{{ section.settings.success_button_link }}" class="promo-popup__button promo-popup__button--link">
              <span>{{ section.settings.success_button_label }}</span>
              {%- render 'icon-chevron-arrow', size: 16 -%}
            </a>
          {%- endif -%}
        {%- else -%}
          <label class="visually-hidden" for="{{ popup_id }}-email">
            {{ section.settings.field_label }}
          </label>
          <input
            id="{{ popup_id }}-email"
            class="promo-popup__field"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.field_label }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            aria-required="true"
            required
          >

          <button type="submit" class="promo-popup__button" name="commit">
            <span>{{ section.settings.button_label }}</span>
            {%- render 'icon-chevron-arrow', size: 16 -%}
          </button>

          {%- if form.errors -%}
            <p class="promo-popup__message promo-popup__message--error" data-promo-popup-result>
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

<script src="{{ 'promo-popup.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Promo popup",
  "settings": [
    {
      "type": "paragraph",
      "content": "Submitting the form adds the address to your customer list and subscribes it to email marketing."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Claim Your" },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading second line",
      "info": "Shown on its own line in a heavier weight.",
      "default": "10% OFF"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up to unlock 10% Off on your first purchase, valid for any product.</p>"
    },
    { "type": "text", "id": "field_label", "label": "Email field placeholder", "default": "Email Address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Claim 10% Off" },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Your code for discount"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "info": "Create the matching code in Discounts, or the code shown here will not work at checkout.",
      "default": "FIRST10"
    },
    {
      "type": "text",
      "id": "success_button_label",
      "label": "Success button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "success_button_link",
      "label": "Success button link"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Maximum width",
      "default": 900
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A1A1A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#424242" },
    { "type": "color", "id": "field_border_color", "label": "Field border", "default": "#1A1A1A" },
    { "type": "color", "id": "placeholder_color", "label": "Field placeholder", "default": "#999999" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#647A73" },
    { "type": "color", "id": "button_label_color", "label": "Button label", "default": "#FFFFFF" },
    { "type": "header", "content": "Behavior" },
    {
      "type": "range",
      "id": "delay",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Show after",
      "default": 5
    },
    {
      "type": "text",
      "id": "reset_key",
      "label": "Reset key",
      "info": "Change this value to show the popup again to visitors who already closed it.",
      "default": "1"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
