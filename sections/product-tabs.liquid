{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .product-tabs__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .product-tabs__heading {
    margin: 0;
  }

  .product-tabs__nav {
    display: flex;
    gap: 3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .product-tabs__nav-button {
    background: none;
    border: none;
    padding: 0 0 0.4rem;
    font: inherit;
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.55);
    cursor: pointer;
    border-bottom: 0.1rem solid transparent;
  }

  .product-tabs__nav-button[aria-selected='true'] {
    color: rgb(var(--color-foreground));
    font-weight: var(--font-heading-weight);
    border-bottom-color: rgb(var(--color-foreground));
  }

  .product-tabs__panel[hidden] {
    display: none;
  }

  .product-tabs__empty {
    text-align: center;
    color: rgba(var(--color-foreground), 0.6);
    padding: 4rem 0;
  }
{%- endstyle -%}

{%- assign default_tab = section.settings.default_tab | plus: 0 -%}

<div class="color-{{ section.settings.color_scheme }} gradient{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class }}{% endif %}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="product-tabs__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="product-tabs__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul class="product-tabs__nav" role="tablist">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign tab_label = section.settings.tab_1_label
              when 2
                assign tab_label = section.settings.tab_2_label
              when 3
                assign tab_label = section.settings.tab_3_label
            endcase
          -%}
          {%- if tab_label != blank -%}
            <li role="presentation">
              <button
                type="button"
                class="product-tabs__nav-button"
                role="tab"
                id="ProductTab-{{ section.id }}-{{ i }}"
                aria-controls="ProductTabPanel-{{ section.id }}-{{ i }}"
                aria-selected="{% if i == default_tab %}true{% else %}false{% endif %}"
                data-product-tabs-trigger
              >
                {{ tab_label | escape }}
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <product-tabs data-default="{{ section.settings.default_tab }}">
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign tab_collection = section.settings.tab_1_collection
            when 2
              assign tab_collection = section.settings.tab_2_collection
            when 3
              assign tab_collection = section.settings.tab_3_collection
          endcase
        -%}
        <div
          class="product-tabs__panel"
          id="ProductTabPanel-{{ section.id }}-{{ i }}"
          role="tabpanel"
          aria-labelledby="ProductTab-{{ section.id }}-{{ i }}"
          data-product-tabs-panel
          {% if i != default_tab %}
            hidden
          {% endif %}
        >
          {%- if tab_collection.products.size > 0 -%}
            <ul class="grid grid--4-col-desktop grid--2-col-tablet-down product-tabs__grid" role="list">
              {%- assign skip_styles = false -%}
              {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
                <li class="grid__item">
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'portrait',
                    show_secondary_image: true,
                    skip_styles: skip_styles,
                    section_id: section.id,
                    quick_add: 'standard'
                  %}
                </li>
                {%- assign skip_styles = true -%}
              {%- endfor -%}
            </ul>
          {%- else -%}
            <p class="product-tabs__empty">{{ 'sections.collection_template.empty' | t }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </product-tabs>
  </div>
</div>

<script src="{{ 'product-tabs.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "class": "section section-product-tabs",
  "settings": [
    {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS class",
      "info": "Add a class here to target this section from assets/custom.css"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore our Products"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "default_tab",
      "options": [
        {
          "value": "1",
          "label": "Tab 1"
        },
        {
          "value": "2",
          "label": "Tab 2"
        },
        {
          "value": "3",
          "label": "Tab 3"
        }
      ],
      "default": "2",
      "label": "Default active tab"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products per tab"
    },
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Label",
      "default": "Best Seller"
    },
    {
      "type": "collection",
      "id": "tab_1_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Label",
      "default": "New Arrival"
    },
    {
      "type": "collection",
      "id": "tab_2_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Tab 3"
    },
    {
      "type": "text",
      "id": "tab_3_label",
      "label": "Label",
      "default": "Featured"
    },
    {
      "type": "collection",
      "id": "tab_3_collection",
      "label": "Collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Product Tabs"
    }
  ]
}
{% endschema %}
