{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .product-tabs__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .product-tabs__heading {
    margin: 0;
  }

  .product-tabs__nav {
    display: flex;
    gap: 3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .product-tabs__nav-button {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 2.8rem;
    color: rgba(66, 66, 66, 0.35);
    cursor: pointer;
  }

  .product-tabs__nav-button[aria-selected='true'] {
    color: rgba(66, 66, 66, 1);
  }

  .product-tabs__mobile-select-wrapper {
    display: none;
  }

  @media screen and (max-width: 767px) {
    .product-tabs__nav {
      display: none;
    }

    .product-tabs__mobile-select-wrapper {
      position: relative;
      display: inline-flex;
      align-items: center;
    }

    .product-tabs__mobile-select {
      appearance: none;
      -webkit-appearance: none;
      background: #eeeeee;
      border: none;
      border-radius: 100px;
      padding: 1rem 3.6rem 1rem 1.8rem;
      font: inherit;
      font-size: 1.5rem;
      color: rgba(66, 66, 66, 1);
      cursor: pointer;
    }

    .product-tabs__mobile-select-icon {
      position: absolute;
      right: 1.6rem;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      pointer-events: none;
      width: 1.2rem;
    }

    .product-tabs__mobile-select-icon svg {
      width: 100%;
      height: auto;
    }
  }

  .product-tabs__panel[hidden] {
    display: none;
  }

  .product-tabs__empty {
    text-align: center;
    color: rgba(var(--color-foreground), 0.6);
    padding: 4rem 0;
  }

  .product-tabs__grid {
    justify-content: space-between;
  }

  @media screen and (min-width: 1280px) {
    .product-tabs__grid .grid__item {
      max-width: 24%;
    }
  }

  .product-tabs__grid .card__title-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 1rem;
    padding-bottom: 20px;
    border-bottom: 0.5px solid #8b8b8b;
  }

  .product-tabs__grid .card__heading {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 2.2rem;
    font-weight: 350;
    margin: 0;
  }

  .product-tabs__grid .card-information {
    display: contents;
  }

  .product-tabs__grid .price {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 2.2rem;
    font-weight: 500;
    color: rgb(var(--color-foreground));
  }

  .product-tabs__grid .card__description {
    margin-top: 1rem;
    font-size: 1.8rem;
    font-weight: 350;
    color: #807a77;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media screen and (max-width: 767px) {
    .product-tabs__grid .card__heading {
      font-size: 1.5rem;
    }

    .product-tabs__grid .price {
      font-size: 1.5rem;
    }

    .product-tabs__grid .card__description {
      font-size: 1.4rem;
    }
  }
{%- endstyle -%}

{%- assign default_tab = section.settings.default_tab | plus: 0 -%}

<div class="color-{{ section.settings.color_scheme }} gradient{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class }}{% endif %}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="product-tabs__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="product-tabs__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul class="product-tabs__nav" role="tablist">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign tab_label = section.settings.tab_1_label
              when 2
                assign tab_label = section.settings.tab_2_label
              when 3
                assign tab_label = section.settings.tab_3_label
            endcase
          -%}
          {%- if tab_label != blank -%}
            <li role="presentation">
              <button
                type="button"
                class="product-tabs__nav-button"
                role="tab"
                id="ProductTab-{{ section.id }}-{{ i }}"
                aria-controls="ProductTabPanel-{{ section.id }}-{{ i }}"
                aria-selected="{% if i == default_tab %}true{% else %}false{% endif %}"
                data-product-tabs-trigger
              >
                {{ tab_label | escape }}
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="product-tabs__mobile-select-wrapper">
        <select class="product-tabs__mobile-select" data-product-tabs-mobile-select aria-label="{{ 'sections.header.menu' | t }}">
          {%- for i in (1..3) -%}
            {%- liquid
              case i
                when 1
                  assign tab_label = section.settings.tab_1_label
                when 2
                  assign tab_label = section.settings.tab_2_label
                when 3
                  assign tab_label = section.settings.tab_3_label
              endcase
            -%}
            {%- if tab_label != blank -%}
              <option value="{{ forloop.index0 }}" {% if i == default_tab %}selected{% endif %}>
                {{- tab_label | escape -}}
              </option>
            {%- endif -%}
          {%- endfor -%}
        </select>
        <span class="product-tabs__mobile-select-icon">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </div>

    <product-tabs data-default="{{ section.settings.default_tab }}">
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign tab_collection = section.settings.tab_1_collection
            when 2
              assign tab_collection = section.settings.tab_2_collection
            when 3
              assign tab_collection = section.settings.tab_3_collection
          endcase
        -%}
        <div
          class="product-tabs__panel"
          id="ProductTabPanel-{{ section.id }}-{{ i }}"
          role="tabpanel"
          aria-labelledby="ProductTab-{{ section.id }}-{{ i }}"
          data-product-tabs-panel
          {% if i != default_tab %}
            hidden
          {% endif %}
        >
          {%- if tab_collection.products.size > 0 -%}
            <ul class="grid grid--4-col-desktop grid--2-col-tablet-down product-tabs__grid" role="list">
              {%- assign skip_styles = false -%}
              {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
                <li class="grid__item">
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'portrait',
                    show_secondary_image: true,
                    skip_styles: skip_styles,
                    section_id: section.id,
                    quick_add: 'standard',
                    show_description: true,
                    show_compare_at_price: false,
                    hide_from_price: true
                  %}
                </li>
                {%- assign skip_styles = true -%}
              {%- endfor -%}
            </ul>
          {%- else -%}
            <p class="product-tabs__empty">{{ 'sections.collection_template.empty' | t }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </product-tabs>
  </div>
</div>

<script src="{{ 'product-tabs.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "class": "section section-product-tabs",
  "settings": [
    {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS class",
      "info": "Add a class here to target this section from assets/custom.css"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore our Products"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "default_tab",
      "options": [
        {
          "value": "1",
          "label": "Tab 1"
        },
        {
          "value": "2",
          "label": "Tab 2"
        },
        {
          "value": "3",
          "label": "Tab 3"
        }
      ],
      "default": "2",
      "label": "Default active tab"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products per tab"
    },
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Label",
      "default": "Best Seller"
    },
    {
      "type": "collection",
      "id": "tab_1_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Label",
      "default": "New Arrival"
    },
    {
      "type": "collection",
      "id": "tab_2_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Tab 3"
    },
    {
      "type": "text",
      "id": "tab_3_label",
      "label": "Label",
      "default": "Featured"
    },
    {
      "type": "collection",
      "id": "tab_3_collection",
      "label": "Collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Product Tabs"
    }
  ]
}
{% endschema %}
