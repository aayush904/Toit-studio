{%- style -%}
  .payment-qr {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .payment-qr {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .payment-qr__inner {
    max-width: 68rem;
    margin: 0 auto;
    text-align: center;
  }

  .payment-qr__heading {
    margin: 0;
    font-family: var(--font-body-family);
    font-weight: var(--font-weight-book);
    font-size: {{ section.settings.heading_size }}px;
    line-height: 115%;
    color: {{ section.settings.heading_color }};
  }

  .payment-qr__account {
    margin: 1.6rem 0 0;
    font-family: var(--font-body-family);
    font-weight: var(--font-weight-medium);
    font-size: 20px;
    line-height: 140%;
    color: {{ section.settings.text_color }};
  }

  .payment-qr__media {
    margin: 3.2rem auto 0;
    max-width: {{ section.settings.qr_width }}px;
  }

  .payment-qr__media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .payment-qr__steps {
    margin: 3.2rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: payment-qr-step;
  }

  .payment-qr__step {
    counter-increment: payment-qr-step;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    margin: 0 0 1.6rem;
    font-family: var(--font-body-family);
    font-weight: var(--font-weight-regular);
    font-size: 18px;
    line-height: 150%;
    color: {{ section.settings.text_color }};
  }

  .payment-qr__step::before {
    content: counter(payment-qr-step);
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: {{ section.settings.step_marker_color }};
    font-weight: var(--font-weight-medium);
    font-size: 16px;
    color: {{ section.settings.step_number_color }};
  }

  .payment-qr__note {
    margin: 2.4rem 0 0;
    font-family: var(--font-body-family);
    font-weight: var(--font-weight-light);
    font-style: italic;
    font-size: 15px;
    line-height: 150%;
    color: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .payment-qr__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .payment-qr__step {
      font-size: 16px;
      text-align: left;
      justify-content: flex-start;
    }
  }
{%- endstyle -%}

<div class="payment-qr color-{{ section.settings.color_scheme }} gradient{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class }}{% endif %}">
  <div class="page-width">
    <div class="payment-qr__inner">
      {%- if section.settings.heading != blank -%}
        <h1 class="payment-qr__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.account_line != blank -%}
        <p class="payment-qr__account">{{ section.settings.account_line }}</p>
      {%- endif -%}

      {%- if section.settings.qr_image != blank -%}
        <div class="payment-qr__media">
          {{
            section.settings.qr_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 480px, 90vw',
              widths: '400, 600, 800, 1200',
              alt: section.settings.qr_image.alt | default: section.settings.heading
          }}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="payment-qr__steps">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <li class="payment-qr__step" {{ block.shopify_attributes }}>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="payment-qr__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Payment QR",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS class",
      "info": "Add a class here to target this section from assets/custom.css"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mobile Banking" },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size on mobile",
      "default": 30
    },
    {
      "type": "text",
      "id": "account_line",
      "label": "Account line",
      "info": "For example an eSewa or mobile banking number.",
      "default": "eSewa Number: 9803459366"
    },
    { "type": "image_picker", "id": "qr_image", "label": "QR code image" },
    {
      "type": "range",
      "id": "qr_width",
      "min": 200,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "QR image width",
      "default": 420
    },
    {
      "type": "text",
      "id": "note",
      "label": "Footnote",
      "default": "*only available for payments within Nepal"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#2B2B2B" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5B5553" },
    { "type": "color", "id": "step_marker_color", "label": "Step circle", "default": "#647A73" },
    { "type": "color", "id": "step_number_color", "label": "Step number", "default": "#FFFFFF" },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Step text", "default": "Scan this QR code" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Payment QR",
      "blocks": [
        { "type": "step", "settings": { "text": "Open your Fonepay banking app" } },
        { "type": "step", "settings": { "text": "Scan this QR code" } },
        { "type": "step", "settings": { "text": "Confirm the payment amount" } }
      ]
    }
  ]
}
{% endschema %}
