      {%- endif -%}
      {%- if settings.social_instagram_link != blank -%}
        {%- assign socials = socials | append: '"' | append: settings.social_instagram_link | append: '",' -%}
      {%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}
        {%- assign socials = socials | append: '"' | append: settings.social_tiktok_link | append: '",' -%}
      {%- endif -%}
      {%- if settings.social_tumblr_link != blank -%}
