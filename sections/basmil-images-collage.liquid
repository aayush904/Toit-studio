{% comment %}
  Section: Image Collage - Basmil
  Description: Responsive grid layout with 6 customizable image cards
{% endcomment %}

<div class="page-width image-collage-basmil" id="image-collage-{{ section.id }}">
  {% if section.settings.heading or section.settings.subheading or section.settings.description or section.settings.button_label %}
    <div class="section-{{section.id}}-header">
      <div class="section-{{section.id}}-header-text">
        {% if section.settings.heading %}
          <h2 class="section-{{section.id}}-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading %}
          <h3 class="section-{{section.id}}-subheading">{{ section.settings.subheading }}</h3>
        {% endif %}
        {% if section.settings.description %}
          <div class="section-{{section.id}}-description">{{ section.settings.description }}</div>
        {% endif %}
      </div>
      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="button button--secondary section-{{section.id}}-button"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {% endif %}
    </div>
  {% endif %}

  <div class="grid-container mobile-scroll-container">
    {% for block in section.blocks limit: 6 %}
      <div class="post-card post-card-{{ forloop.index }} mobile-scroll-container-item" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | img_url: '800x800' }}"
            alt="{{ block.settings.image.alt | default: block.settings.title }}"
            class="post-image"
            loading="lazy"
            width="800"
            height="800"
          >
        {% else %}
          <div class="placeholder-image placeholder-{{ forloop.index }}">
            {{ block.settings.title | default: 'Add Image' }}
          </div>
        {% endif %}

        {%- liquid
          assign show_caption_block = false
          if section.settings.show_captions and block.settings.title != blank
            assign show_caption_block = true
          endif
          if section.settings.show_captions and block.settings.subtitle != blank
            assign show_caption_block = true
          endif
        -%}
        {% if show_caption_block %}
          <div class="profile-info">
            {% if block.settings.title %}
              <div class="profile-name">{{ block.settings.title }}</div>
            {% endif %}
            {% if block.settings.subtitle %}
              <div class="profile-handle">{{ block.settings.subtitle }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.link %}
          <a
            href="{{ block.settings.link }}"
            class="card-link"
            aria-label="{{ block.settings.title | default: 'View content' }}"
          ></a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .image-collage-basmil [class$='-header'] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .image-collage-basmil [class$='-header'] h2,
  .image-collage-basmil [class$='-header'] h3 {
    text-align: left;
    margin: 0;
  }

  .image-collage-basmil .grid-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, auto);
    gap: 20px;
    margin: 0 auto;
  }

  .image-collage-basmil .post-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    background: #333;
    aspect-ratio: 4/5;
  }

  .image-collage-basmil .post-card-3,.image-collage-basmil .post-card-4{
    aspect-ratio: 2/1.2;
  }

  .image-collage-basmil .post-card:hover .post-image {
    transform: scale(1.1);
  }

  .image-collage-basmil .post-image {
    transition: transform 0.35s ease-in-out;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .image-collage-basmil .post-card:after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000000;
    opacity: 0.15;
  }

  .image-collage-basmil .card-link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    text-decoration: none;
    display: block;
  }

  .image-collage-basmil .profile-info {
    position: absolute;
    top: 16px;
    left: 16px;
    color: white;
    z-index: 2;
  }

  .image-collage-basmil .profile-name {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  .image-collage-basmil .profile-handle {
    font-size: 12px;
    opacity: 0.9;
    font-weight: 400;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  /* Grid layout: 4 columns x 2 rows */
  .image-collage-basmil .post-card-1 {
    grid-column: 1;
    grid-row: 1;
  }

  .image-collage-basmil .post-card-2 {
    grid-column: 2;
    grid-row: 1;
  }

  .image-collage-basmil .post-card-3 {
    grid-column: 3 / 5;
    grid-row: 1;
  }

  .image-collage-basmil .post-card-4 {
    grid-column: 1 / 3;
    grid-row: 2;
  }

  .image-collage-basmil .post-card-5 {
    grid-column: 3;
    grid-row: 2;
  }

  .image-collage-basmil .post-card-6 {
    grid-column: 4;
    grid-row: 2;
  }

  /* Placeholder styling */
  .image-collage-basmil .placeholder-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
    font-weight: 500;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  .image-collage-basmil .placeholder-1 {
    background: linear-gradient(135deg, #4a5568, #2d3748);
  }

  .image-collage-basmil .placeholder-2 {
    background: linear-gradient(135deg, #9f7aea, #805ad5);
  }

  .image-collage-basmil .placeholder-3 {
    background: linear-gradient(135deg, #ed8936, #dd6b20);
  }

  .image-collage-basmil .placeholder-4 {
    background: linear-gradient(135deg, #f56565, #e53e3e);
  }

  .image-collage-basmil .placeholder-5 {
    background: linear-gradient(135deg, #38b2ac, #319795);
  }

  .image-collage-basmil .placeholder-6 {
    background: linear-gradient(135deg, #48bb78, #38a169);
  }

  /* Responsive design */
  {% comment %} @media (max-width: 1024px) {
    .image-collage-basmil .grid-container {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 250px);
    }

    .image-collage-basmil .post-card-1 {
      grid-column: 1;
      grid-row: 1;
    }

    .image-collage-basmil .post-card-2 {
      grid-column: 2;
      grid-row: 1;
    }

    .image-collage-basmil .post-card-3 {
      grid-column: 3;
      grid-row: 1;
    }

    .image-collage-basmil .post-card-4 {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .image-collage-basmil .post-card-5 {
      grid-column: 3;
      grid-row: 2;
    }

    .image-collage-basmil .post-card-6 {
      display: none;
    }
  } {% endcomment %}

  @media (max-width: 768px) {
    .image-collage-basmil .grid-container {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(4, 220px);
    }

    .image-collage-basmil .post-card-1 {
      grid-column: 1;
      grid-row: 1;
    }

    .image-collage-basmil .post-card-2 {
      grid-column: 2;
      grid-row: 1;
    }

    .image-collage-basmil .post-card-3 {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .image-collage-basmil .post-card-4 {
      grid-column: 1 / 3;
      grid-row: 3;
    }

    .image-collage-basmil .post-card-5 {
      grid-column: 1;
      grid-row: 4;
      display: block;
    }

    .image-collage-basmil .post-card-6 {
      grid-column: 2;
      grid-row: 4;
      display: block;
    }

    .image-collage-basmil .profile-name {
      font-size: 14px;
    }

    .image-collage-basmil .profile-handle {
      font-size: 11px;
    }
  }

  @media (max-width: 480px) {
    .image-collage-basmil .grid-container {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(6, 200px);
    }

    .image-collage-basmil .post-card-1,
    .image-collage-basmil .post-card-2,
    .image-collage-basmil .post-card-3,
    .image-collage-basmil .post-card-4,
    .image-collage-basmil .post-card-5,
    .image-collage-basmil .post-card-6 {
      grid-column: 1;
      display: block;
    }

    .image-collage-basmil .post-card-1 {
      grid-row: 1;
    }
    .image-collage-basmil .post-card-2 {
      grid-row: 2;
    }
    .image-collage-basmil .post-card-3 {
      grid-row: 3;
    }
    .image-collage-basmil .post-card-4 {
      grid-row: 4;
    }
    .image-collage-basmil .post-card-5 {
      grid-row: 5;
    }
    .image-collage-basmil .post-card-6 {
      grid-row: 6;
    }
  }
</style>

{% schema %}
{
  "name": "Image Collage - Basmil",
  "tag": "section",
  "class": "section-image-collage-basmil",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "info": "Main title for the section"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading",
      "info": "Subtitle for the section"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "info": "Optional description text for the section"
    },
    {
      "type": "checkbox",
      "id": "show_captions",
      "label": "Show name/handle captions on images",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Shown next to the heading, e.g. Follow Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "default": "image-collage-basmil",
      "info": "Unique identifier for this section"
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Image Card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "@handle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Collage - Basmil",
      "blocks": [
        {
          "type": "image_card",
          "settings": {
            "title": "Meenakshi",
            "subtitle": "@behind_that_house"
          }
        },
        {
          "type": "image_card",
          "settings": {
            "title": "Yashvika",
            "subtitle": "@yashvikaghai"
          }
        },
        {
          "type": "image_card",
          "settings": {
            "title": "Ayesha Adlakha",
            "subtitle": "@ayeshaadlakha"
          }
        },
        {
          "type": "image_card",
          "settings": {
            "title": "Mansi Ugale",
            "subtitle": "@mansiugale"
          }
        },
        {
          "type": "image_card",
          "settings": {
            "title": "Neha Singh",
            "subtitle": "@nehasingh27"
          }
        },
        {
          "type": "image_card",
          "settings": {
            "title": "Adhya S",
            "subtitle": "@auraofhealthyliving"
          }
        }
      ]
    }
  ]
}
{% endschema %}
