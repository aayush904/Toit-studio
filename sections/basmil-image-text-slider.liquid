{% schema %}
{
  "name": "Image Text Slider-Basmil",
  "settings": [
    {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS class",
      "info": "Add a class here to target this section from assets/custom.css"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "options": [
        {
          "value": "overlay",
          "label": "Overlay"
        },
        {
          "value": "side",
          "label": "Side-by-side"
        }
      ],
      "default": "overlay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (ms)",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "default": 3000
    },
    {
      "type": "number",
      "id": "slider_height",
      "label": "Slider Height (px)"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Image Text Slider-Basmil",
      "category": "Sliders",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
{% assign position = section.settings.text_position %}

<div
  class="image-text-slider  {% if position == 'side' %} page-width{% endif %}{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class }}{% endif %}"
  data-slick-slider
  data-slidesperview="1"
  data-slidestoscroll="1"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplayspeed="{{ section.settings.autoplay_speed }}"
  data-arrows="true"
  data-dots="true"
  data-loop="true"
>
  {% for block in section.blocks %}
    {% if block.type == 'slide' %}
      <div class="slider-slide {{ position }}">
        <div class="slide-wrapper">
          {% if position == 'side' %}
            <div class="slide-content side-layout">
              <div class="slide-image">
                {% if block.settings.image %}
                  <img
                    src="{{ block.settings.image | image_url: width: block.settings.image.width, height: block.settings.image.height }}"
                    alt="{{ block.settings.heading | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {% endif %}
              </div>
              <div class="slide-text">
                <h1>{{ block.settings.heading }}</h1>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {% else %}
            <div class="slide-content overlay-layout">
              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: block.settings.image.width, height: block.settings.image.height }}"
                  alt="{{ block.settings.heading | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% endif %}
              <div class="overlay-text">
                <h1>{{ block.settings.heading }}</h1>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
  #shopify-section-{{ section.id }} {
    padding-bottom:50px;

      .image-text-slider {
      position: relative;
      width: 100%;
      height: auto;
      min-height: 200px;

      }


      .slick-list {
      overflow:hidden!important;
      }
    .slick-arrow{
        top: 50%;
    }


      .slick-slide,.slick-track{
      margin: 0;
      transition: unset !important;
      }

      .image-text-slider{
      {% if position == 'side' %}
          margin-bottom:25px;
      {% endif %}
      }

      .image-text-slider .side-layout{
      min-height:100%;
      }

      .image-text-slider .slide-wrapper {
      position: relative;
      width: 100%;
      height: {{ section.settings.slider_height | minus: 14 }}px;
      min-height: 200px;
      overflow: hidden;
      }
      .image-text-slider .overlay-layout img,
      .image-text-slider .side-layout .slide-image img {
      height: 100%;
      max-height: 100%;
      }


      .image-text-slider .slick-slide img{
        --scale-factor: 1.1;
      transition: transform 0.9s ease-in-out;
      object-fit: cover;
      object-position: center;
      animation: 0.9s cubic-bezier(.25, .6, .5, .95) zoomOut;
      animation-fill-mode: forwards;
      min-width: 100%;
    }
    .image-text-slider .slick-slide.slick-active img {
      animation: 0.9s cubic-bezier(.25, .6, .5, .95) zoomOut;

      }

      .overlay-text {
      position: absolute;
      top: 50%;
      left: 50%;
      width: calc(100% - 60px);
      transform: translate(-50%, -50%);
      text-align: center;
      }

      .overlay-text:before{
        content: "";
        position: absolute;
        top: -100px;
        bottom: -100px;
        left: -200px;
        right: -200px;
        z-index: -1;
        border-radius: 50%;
        background: radial-gradient(#00000026, #0000 65%);
        }

        .overlay-text h1{
        font-size: 69.12px;
        font-weight: 700;
        {% if position == 'side' %}
          margin:0 0 .5em;
          color: #000;
        {% else %}
            color: #fff;
            margin:0;
        {% endif %}
        }

                .overlay-text p{
        font-size: 19.95px;
        margin:0 0 .5em;
        {% if position == 'side' %}
          color: #000;
        {% else %}
            color: #fff;
        {% endif %}
        }

      .image-text-slider .slick-dots {
      position: absolute;
      left: 0;
      right: 0;
      display: flex !important;
      justify-content: center;
      align-items: center;
      width: 100%;
      z-index: 10;
      padding: 0;
      margin: 0;
      pointer-events: auto;
      {% if position == 'side' %}
          bottom: -25px;
      {% else %}
          bottom: 25px;
      {% endif %}
      }
      .image-text-slider .slick-dots li {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: max-content;
      height: max-content;
      margin: 0 4px;
      padding: 0;
      border-radius: 50%;
      background: transparent;
      border: none;
      }
      .image-text-slider .slick-dots button {
      width: 10px;
      height: 10px;
      opacity: 0.5;
      border-radius: 50px;
      {% if position == 'side' %}
          border: 1px solid #000;
      {% else %}
          border: 1px solid #fff;
      {% endif %}
          background: transparent;
      transition: all 0.3s cubic-bezier(.4,0,.2,1);
      padding: 0;
      outline: none;
      box-sizing: border-box;
      display: block;
      margin: 0 auto;
      color:transparent;
      overflow: hidden;
      }
      .image-text-slider .slick-dots .slick-active button {
      width: 25px;
      height: 10px;
      border-radius: 50px;
      opacity: 1;
      }
      .image-text-slider .side-layout {
      display: flex;
      flex-wrap: wrap;
      }
      .image-text-slider .side-layout .slide-image {
        flex: 1 1 50%;
      }
      .image-text-slider .side-layout .slide-image img {
        width: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .image-text-slider .side-layout .slide-text {
        flex: 1 1 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2rem;
      }

      @media (min-width: 1025px) {
              .image-text-slider .slide-wrapper {
                  height: {{ section.settings.slider_height | default: 364 }}px;
              }
        }

      @media (max-width: 768px) {
        .overlay-text {
            position: absolute;
            top: 50%;
            left: 50%;
            width: calc(100% - 60px);
            transform: translate(-50%, -50%);
        }
    }
  }
</style>
