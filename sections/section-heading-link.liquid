{%- comment -%}
  A heading with a button on the same row. Built for the Instafeed app block,
  whose markup belongs to the app and so cannot take a button of its own --
  this sits directly above it and the app's own title is hidden in CSS.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .heading-link-{{ section.id }} .heading-link__title {
    font-size: {{ section.settings.heading_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .heading-link-{{ section.id }} .heading-link__title {
      font-size: {{ section.settings.heading_size }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class }}{% endif %}">
  <div class="heading-link heading-link-{{ section.id }} page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="heading-link__title inline-richtext">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        {% if section.settings.button_link == blank %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ section.settings.button_link }}"
          {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
        {% endif %}
        class="heading-link__button"
      >
        <span>{{ section.settings.button_label | escape }}</span>
        {%- if section.settings.show_arrow -%}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Heading with button",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS class",
      "info": "Add a class here to target this section from assets/custom.css"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "@toit.studio"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 50
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 28
    },
    {
      "type": "header",
      "content": "Button"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in a new tab", "default": true },
    { "type": "checkbox", "id": "show_arrow", "label": "Show arrow", "default": true },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    { "name": "Heading with button" }
  ]
}
{% endschema %}
