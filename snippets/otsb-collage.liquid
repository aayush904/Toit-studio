<div id="collage-{{ section.id }}" class="otsb-grid otsb-collage grid-cols-{{ min_columns_mobile }} md:grid-cols-{{ max_columns }} spacing--{{ section.id }}">
{%- for block in section.blocks -%}
  {%- liquid 
    assign columns_desktop = block.settings.number_of_columns
    assign columns_mobile = block.settings.number_of_columns
    
    if columns_desktop > max_columns
      assign columns_desktop = max_columns  
    endif
    if columns_mobile > min_columns_mobile
      assign columns_mobile = min_columns_mobile
    endif

    assign percent_width = max_columns | divided_by: columns_desktop | round
  -%}
  <div class="{% if section.settings.edges_type == 'rounded_corners' %} rounded-[10px] {% endif %} flex flex-col overflow-hidden relative col-span-{{ columns_mobile }} md:col-span-{{ columns_desktop }} row-span-{{ block.settings.number_of_row }}{% if block.type == 'product' %} collage-product-{{ percent_width }}-{{ block.settings.desktop_size }}{% endif %}{% if block.type == 'video' %} group{% endif %}" {{ block.shopify_attributes }} >
    {%- case block.type -%}
      {%- when 'image' -%}
        {% liquid
          assign main_button_classes = ''
          case block.settings.button_type
            when 'square'
            assign main_button_classes = main_button_classes | append: ' otsb-btn-square'
            when 'rounded'
            assign main_button_classes = main_button_classes | append: ' otsb-btn-rounded'
            when 'rounded_corners'
            assign main_button_classes = main_button_classes | append: ' otsb-btn-rounded-corners'
            when 'mixed'
            assign main_button_classes = main_button_classes | append: ' otsb-btn-mixed'
          endcase
          case block.settings.button_animation
            when 'slide'
            assign main_button_classes = main_button_classes | append: ' otsb-btn__slide'
            when 'fill_up'
            assign main_button_classes = main_button_classes | append: ' otsb-btn__fill_up'
            when 'underline'
            assign main_button_classes = main_button_classes | append: ' otsb-btn__underline'
            when 'sliced'
            assign main_button_classes = main_button_classes | append: ' otsb-btn__sliced'
          endcase              
        %}
        <div class="relative group h-full w-full flex items-center">
          {%- if section.settings.full_width -%}
            {%- capture sizes -%}(min-width: 1025px) {% if section.blocks.size == 1 %}100vw{% else %}70vw{% endif %}, (min-width: 768px){% if section.blocks.size == 1 %} 100vw{% else %} 540px{% endif %}, 100vw{%- endcapture -%}
          {%- else -%}
            {%- capture sizes -%}(min-width: {{ settings.page_width }}px) {% if section.blocks.size == 1 %}{{ settings.page_width }}px{% else %}{{ settings.page_width | times: 0.7 | round }}px{% endif %}, (min-width: 768px){% if section.blocks.size == 1 %} calc(100vw - 30px){% else %} 540px{% endif %}, calc(100vw - 30px){%- endcapture -%}
          {%- endif -%}
          {% render 'otsb-promotion-image',
            blockID: block.id,
            image: block.settings.image,
            image_link: block.settings.image_link,
            image_ratio: 'auto',
            enable_text_overlay: true,
            heading: block.settings.title,
            subheading: block.settings.sub_title,
            content: block.settings.text,
            button_label: block.settings.button_label,
            button_link: block.settings.button_link,
            content_alignment: block.settings.text_align,
            full_width: section.settings.full_width,
            overlay_opacity: block.settings.overlay_opacity,
            overlay_color  : block.settings.overlay_color,
            show_button_style: block.settings.show_button_style,
            title_color: block.settings.title_color,
            color_text: block.settings.text_color,
            color_button: block.settings.color_button,
            color_text_button: block.settings.color_text_button,
            color_button_hover: block.settings.color_button_hover,
            color_text_button_hover: block.settings.color_text_button_hover,
            color_button_secondary: block.settings.color_button_secondary,
            secondary_button_text: block.settings.secondary_button_text,
            colors_text_link: block.settings.colors_text_link,
            heading_size: block.settings.title_size,
            text_size: block.settings.text_size,
            content_position: block.settings.content_position,
            open_new_window : block.settings.open_new_window,
            open_new_window_button: block.settings.open_new_window_button
            sizes: sizes,
            collage: true,
            highlight_type: block.settings.highlight_type,
            animation_loading: true,
            original_image_ratio: block.settings.image_padding,
            main_button_classes: main_button_classes,
            button_animation: block.settings.button_animation,
            custom_icon_button: block.settings.custom_icon_button,
            button_color_mobile: block.settings.button_color_mobile,
          %}
        </div>
      {%- when 'product' -%}
        {%- if block.settings.product != blank %}
          {%- liquid
          
            assign disable_quickview = true
            if block.settings.show_quickview
              assign disable_quickview = false
            endif 
            assign index_param = section.index | append: forloop.index | plus: 0
            assign section_id = section.id | append: forloop.index
          -%}
          {%- render 'otsb-card-product',
            card_product: block.settings.product, 
            collage: true,
            extend_height: false,
            columns_desktop: 1,
            block_id: forloop.index,
            disable_quickview: disable_quickview,
            info_alignment: block.settings.info_alignment,
            card_full_width: section.settings.full_width_mobile,
            full_width: section.settings.full_width,
            show_rating: show_rating,
            show_vendor: show_vendor,
            columns_desktop: columns_desktop,
            columns_mobile: columns_mobile,
            max_columns: max_columns,
            min_columns_mobile: min_columns_mobile,
            section_id: section_id,
            product_card_id: forloop.index,
            index_param: index_param,
            animation_loading: true,
            edges_type: section.settings.edges_type,
          -%}
          <script src="{{ 'otsb-preview-color-swatches.min.js' | asset_url }}" defer></script>
        {% else %}
          <div class="flex flex-col h-full">
            <div class="grow{% if section.settings.edges_type == 'rounded_corners' %} overflow-hidden md:rounded-[10px] rounded-[10px]{% endif %}"> 
              {% render 'otsb-icon-placeholder', icon: 'icon-product' | class: 'bg-[#c9c9c9] w-full h-full' %}
            </div>
            <div class="pt-4 pb-4 text-{{ block.settings.info_alignment }}{% if section.settings.full_width_mobile %} pl-5 pr-5 md:pl-0 md:pr-0{% endif %}">
              <h3 class="leading-tight text-[rgba(var(--colors-heading))]">
                Example Product
              </h3>
              <p class="price mt-2">
                {% if settings.currency_code_enable %}
                  {{ 3000 | money_with_currency }}
                {% else %}
                  {{ 3000 | money }}
                {% endif %}
              </p>
            </div>
          </div>
        {% endif %}
      {%- when 'collection' -%}
        {%- liquid
          assign image_ratio = 100
          if block.settings.collection.featured_image != blank 
            assign image_ratio = 'auto'
          endif
        -%}
        {% render 'otsb-card-collection',
          card_collection: block.settings.collection,
          show_item_count: section.settings.show_item_count,
          image_ratio: image_ratio,
          extend_height: true,
          collage: true,
          columns_desktop: 1,
          columns: 2,
          ratio: 100,
          block_type: "featured_collection",
          card_full_width: section.settings.full_width_mobile,
          content_alignment: "center",
          full_width: section.settings.full_width,
          columns_desktop: columns_desktop,
          columns_mobile: columns_mobile,
          max_columns: max_columns,
          min_columns_mobile: min_columns_mobile,
          title_color: section.settings.heading_color,
        %}
      {%- when 'video' -%}
        {% liquid 
          assign video_alt = block.settings.video_alt_text
          assign video_type = false
          if block.settings.video_url.type == 'youtube' 
            assign video_type = 'youtube'
            assign video_id = block.settings.video_url.id
          endif

          if block.settings.video_url.type == 'vimeo' 
            assign video_type = 'vimeo'
            assign video_id = block.settings.video_url.id
          endif

          if block.settings.video != null 
              assign video_type = 'video_select'
          endif 
        %}
        {%- style -%}
          .block-video-{{ block.id }} {
            --image-treatment-text: {{ block.settings.colors_video_icon.red }}, {{ block.settings.colors_video_icon.green }}, {{ block.settings.colors_video_icon.blue }};
          }
        {%- endstyle -%}
        {% if block.settings.enable_video_autoplay and video_type != false %}
          
          <div class="block-video-{{ block.id }} h-full{% if block.settings.video_url != blank %} flex items-center{% endif %}"> 
            <div class="{% if section.settings.edges_type == 'rounded_corners' %} rounded-[10px] {% endif %} relative otsb-external-video{% if video_type != 'video_select' %} h-0{% if request.design_mode %} pb-[55.75%]{% else %} pb-[56.25%]{% endif %} md:h-full{% else %} h-full{% endif %} w-full overflow-hidden otsb-video-hero{% if settings.edges_type == 'rounded_corners' %} md:rounded-[10px]{% unless section.settings.full_width_mobile %} rounded-[10px]{% endunless %}{% endif %}" 
            aria-label="{{ 'sections.video.load_video' | t: video_alt_text: block.settings.video_alt_text | escape }}"
            x-intersect:leave="$store.xVideo.pause($el)"
            @click.stop="$store.xVideo.togglePlay($el)"
            {% if video_type == 'video_select' %}x-intersect="$store.xVideo.play($el)"{% endif %}  
            {% if video_type == 'youtube' or video_type == 'vimeo' %}
              x-intersect.once="$store.xVideo.externalLoad($el, '{{ video_type }}', '{{ video_id }}', false, '{{ video_alt }}', 1)"
              x-intersect="$store.xVideo.play($el)"
            {% endif %}
            {% if block.settings.video != blank %}
              style="padding-bottom: {{ 1 | divided_by: block.settings.video.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- render 'otsb-media-video',
              collage: true,
              enable_video_autoplay: true,
              video_type: video_type,
              video_id: video_id,
              video_alt: video_alt,
              video: block.settings.video,
              cover_image: block.settings.image,
              show_sound_control: block.settings.show_sound_control
            -%}
          </div>
          </div>
        {% else %}
          <div 
            class="block-video-{{ block.id }} h-full {% if block.settings.video_url != blank %} flex items-center{% endif %}" 
            x-data="{open: false}"
          > 
            <div class="relative h-full w-full overflow-hidden{% if section.settings.edges_type == 'rounded_corners' %} md:rounded-[10px] rounded-[10px] {% endif %}" 
              aria-label="{{ 'sections.video.load_video' | t: video_alt_text: block.settings.video_alt_text | escape }}"
            >
              <button
                id="OpenVideoModal-{{ block.id }}"
                {% if video_type != false %}@click="$store.otsb_xModal.setActiveElement('OpenVideoModal-{{ block.id }}'); open = true; $store.xPopup.open = true;"{% else %}disabled{% endif %}
                class="z-[1] group button-play absolute z-20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 md:w-24 md:h-24 rounded-full p-5 bg-[rgba(var(--image-treatment-text),0.3)] bg-opacity-30 disabled:cursor-not-allowed" aria-label="image-video">
                <span class="pointer-events-none duration-200 group-hover:scale-125 bg-button-play absolute w-5 h-5 md:w-10 md:h-10 top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 text-[rgba(var(--image-treatment-text))]">
                  {% render 'otsb-icon-media', icon: 'icon-play', class: 'w-full h-full' %}
                </span>
              </button>
              {% if video_type == 'youtube' %}
                {% comment %}theme-check-disable RemoteAsset{% endcomment %}
                <div
                  class="h-full w-full">
                  <picture>
                    <source type="image/webp" srcset="{{ video_id | prepend: 'https://i.ytimg.com/vi_webp/' | append: '/maxresdefault.webp' }}">
                    <source type="image/jpeg" srcset="{{ video_id | prepend: 'https://i.ytimg.com/vi/' | append: '/maxresdefault.jpg' }}">
                    <img 
                      src="{{ video_id | prepend: 'https://i.ytimg.com/vi_webp/' | append: '/maxresdefault.webp' }}" 
                      loading="lazy"  
                      alt="{{ video_alt }}" class="w-full h-full object-cover" alt="dd" width="1280" height="890"
                    />
                  </picture>
                </div>
                {% comment %}theme-check-enable RemoteAsset{% endcomment %}
              {% endif %}  
              {% if video_type == 'vimeo' %}
                {%- capture options -%}
                  {
                    'alt': '{{ video_alt }}',
                    'width': 1280
                  }
                {%- endcapture -%}
                <div class="w-full h-full" x-init="$store.xVideo.renderVimeoFacade($el, '{{ video_id }}', {{ options }})"></div>
              {% endif %}  
              {% if video_type == "video_select" %}
                {{ block.settings.video
                  | video_tag:
                    image_size: "1100x",
                    loop: false,
                    controls: false,
                    muted: false,
                    class: "w-full h-full object-cover",
                    alt: block.settings.video.alt
                }}
              {% endif %}
            
              {% if video_type == false %}
                <div class="bg-[#c9c9c9] h-full w-full z-0">
                  {%- render 'otsb-icon-media', icon: 'icon-video' , class: ' text-[#acacac] w-full h-full scale-50' -%}
                </div>
              {% endif %}
            </div>
            <div 
              id="VideoModal-{{ block.id }}"
              class="top-0 left-0 right-0 bottom-0 bg-[rgba(var(--background-color))] duration-150 block fixed z-50"
              x-show="open"
            
              x-cloak
            >
              <button
                id="CloseVideoModal-{{ block.id }}"
                class="btn-close button button-action w-[48px] h-[48px] min-w-[48px] min-h-[48px] disable-effect button_rounded rounded-full p-4 cursor-pointer z-20 fixed right-4 top-4"
                @click="open = false; " 
              >
                {% render 'otsb-icon-alls', icon: 'icon-close' %}
              </button>
              <div class="relative z-10 h-[80%] mt-24 w-[90%] m-auto overflow-hidden modal-content"
              >
                <div x-intersect:leave="$store.xVideo.pause($el)"
              x-intersect="$store.xVideo.play($el)" class="{% if section.settings.edges_type == 'rounded_corners' %} md:rounded-[10px] {% endif %} otsb-external-video" {% if video_type == 'youtube' or video_type == 'vimeo' %}x-intersect.once="$store.xVideo.externalLoad($el, '{{ video_type }}', '{{ video_id }}', false, '{{ block.settings.video_alt_text | escape }}')"{% endif %}>
                {% if video_type == "video_select" %}
                  {{ block.settings.video
                    | video_tag:
                      image_size: "1100x", 
                      loop: false,
                      controls: true,
                      autoplay: true,
                      muted: false,
                      class: "w-full h-full absolute top-0 left-0 otsb-video object-cover",
                      alt: block.settings.video.alt
                  }}
                {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {%- endcase -%}
    </div>
  {%- endfor -%}
</div>