{%- assign related_products = product.metafields.custom.buy_it_with.value -%}

{% if related_products and related_products != blank %}
  <div
    class="buy-it-with-slider"
    data-slick-slider
    data-slidesperview="1"
    data-dots="true"
    data-arrows="false"
    data-loop="true"
  >
    {% for related_product in product.metafields.custom.buy_it_with.value %}
      <div class="slide-item">
        <div class="flex-1 biw-content">
          <p class="biw-label">Buy It With</p>

          <p class="biw-title">{{ related_product.title }}</p>
          {% assign product_form_id = 'quick-add-' | append: section.id | append: related_product.id %}

          <modal-opener data-modal="#QuickAdd-{{-related_product.id-}}">
            <button
              id="{{-product_form_id-}}-submit"
              type="submit"
              name="add"
              class="quick-add__submit button button--full-width button--secondary"
              aria-haspopup="dialog"
              aria-labelledby="{{-product_form_id-}}-submit title-{{- section.id -}}-{{- related_product.id -}}"
              data-product-url="{{related_product.url}}"
            >
              <span class="quick-add__submit-text"> QUICK BUY </span>

              <div class="loading__spinner hidden">
                <svg xmlns="http://www.w3.org/2000/svg" class="spinner" viewBox="0 0 66 66">
                  <circle stroke-width="6" cx="33" cy="33" r="30" fill="none" class="path"></circle>
                </svg>
              </div>
            </button>
          </modal-opener>
        </div>

        {% if related_product.featured_image %}
          <div class="biw-img">
            <img
              src="{{ related_product.featured_image | img_url: '300x300' }}"
              alt="{{ related_product.title }}"
              loading="lazy"
              width="300"
              height="300"
            >
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endif %}
<style>
  /* ─────────────────────────────────────
   BUY‑IT‑WITH  (custom.buy_it_with slider)
   ──────────────────────────────────── */

  /* Card wrapper */
  .buy-it-with-slider[data-slick-slider] {
    overflow: hidden !important;
  }

  .buy-it-with-slider * {
    user-select: none; /* prevent text selection */
    user-drag: none;
    -webkit-user-drag: none;
    -moz-user-select: none;
  }
  /* Slide item */
  .buy-it-with-slider .slide-item {
    background: #ede3d7; /* beige card */
    border-radius: 12px; /* rounded corners */
    padding: 1.5rem 1.25rem;
    display: flex;
    max-height: 160px;
    align-items: center;
    gap: 1.5rem;
  }

  /* Content holder */
  .buy-it-with-slider .slide-item .biw-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5px 10px;
  }

  /* “Buy It With” label */
  .buy-it-with-slider .slide-item .biw-label {
    font-size: 11.4px; /* 12 px */
    color: #111;
    opacity: 0.7;
    margin: 0 0 10px;
  }

  /* Product title */
  .buy-it-with-slider .slide-item .biw-title {
    font-size: 1.28rem; /* 16 px */
    font-weight: 600;
    color: #111;
    margin: 0 0 0.75rem;
  }

  /* Pill button */
  .buy-it-with-slider .slide-item modal-opener {
    width: max-content;
  }
  .buy-it-with-slider .slide-item .quick-add__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    text-transform: uppercase;
    line-height: 1;
    text-decoration: none;
    padding: 12px 28px;
    max-width: max-content;
    width: 100%;
    font-size: 11.9px; /* 14px */
    height: max-content;
    min-height: min-content;
    border: 1px solid #111;
    border-radius: 9999px;
    color: #111;
    background: transparent;
    transition: all 0.25s ease;
  }
  .buy-it-with-slider .slide-item .quick-add__submit:hover {
    background: #111;
    color: #fff;
  }

  /* Product image holder */
  .buy-it-with-slider .slide-item .biw-img {
    flex: 1;
    border-radius: 12px;
    overflow: hidden;
    max-height: calc(160px - 3rem);
  }
  .buy-it-with-slider .slide-item .biw-img img {
    height: 100%;
    width: 100%;
    max-height: calc(160px - 3rem);
    object-fit: cover;
    object-position: center;
  }

  /* Mobile tweak: stack content */
  @media (max-width: 640px) {
    .buy-it-with-slider .slide-item {
      flex-direction: column;
      align-items: flex-start;
    }
    .buy-it-with-slider .slide-item .biw-img {
      width: 100%;
      height: auto;
      margin-top: 1rem;
    }
  }

  /* ── Slick dots (two little hollow/filled circles) ── */
  .buy-it-with-slider .slick-dots {
    display: flex !important;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }
  .buy-it-with-slider .slick-dots li {
    margin: 0;
    list-style: none;
    border: 1px solid #111;
    background: transparent;
    font-size: 0; /* hide “dot” text */
    border: 1px solid #0d0d0d;
    transition: border 0.5s ease, width 0.5s ease, opacity 0.5s ease;
    pointer-events: auto;
    display: inline-block;
    width: 10px;
    height: 10px;
    margin: 0 8px;
    border-radius: 5px;
    opacity: 0.25;
    cursor: pointer;
  }

  .buy-it-with-slider .slick-dots button {
    font-size: 0; /* hide “dot” text */
    height: 100%;
    width: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
  }
  .buy-it-with-slider .slick-dots li.slick-active {
    opacity: 1;
    width: 25px;
    border-radius: 5px;
  }

  /* We turned arrows off in data attributes, but just in case */
  .buy-it-with-slider .slick-arrow {
    display: none !important;
  }
</style>
