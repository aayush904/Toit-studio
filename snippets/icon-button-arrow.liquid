{% comment %}
  Renders the arrow icon shown after button text. Uses stroke="currentColor"
  so it automatically matches the button's own text color (black on
  .button--primary, white on .button--secondary).
{% endcomment %}
<span class="button__icon">
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
    <path d="M5 1L11 7L5 13" stroke="currentColor" stroke-width="1.5"/>
  </svg>
</span>
