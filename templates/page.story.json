        "heading": "Shop Jayant's Favourites",
        "subheading": "<script>\n  $(function () {\n    const $section = $('#shopify-section-{{ section.id }}');\n    const $first   = $section.find('.slick-first-slide');\n    const $normalSlide= $section.find('.slick-active:not(.slick-first-slide)');\n    const styleId  = 'slick-first-slide-style-{{ section.id }}';\n\n    function applyWidth () {\n      if (!$first.length) return;\n      const w = $normalSlide.outerWidth();\n      const css = `#shopify-section-{{ section.id }} { .slick-first-slide{width:${w}px;min-width:${w}px!important;max-width:${w}px!important;}}`;\n      let $style = $('#' + styleId);\n      if ($style.length) {\n        $style.text(css);\n      } else {\n        $('<style>', { id: styleId }).text(css).appendTo('footer');\n      }\n    }\n\n    applyWidth();\n\n    let t;\n    $(window).on('resize orientationchange load', () => {\n      clearTimeout(t);\n      t = setTimeout(applyWidth, 100);\n    });\n  });\n</script>",
